  "concepts": [
    {
      "priority": "primary",
      "labelZhHant": "湯杓與舀取",
      "meaningLines": [
        {
          "partOfSpeech": "noun",
          "meaningZhHant": "可數；杓面深、柄長，用來盛湯、醬汁等，不是一般吃飯用的湯匙。"
        },
        {
          "partOfSpeech": "verb",
          "meaningZhHant": "用這類杓子盛取或分裝；受詞通常是湯、醬汁等食物或液體。"
        }
      ],
      "expressions": [
        {
          "expression": "ladle something into a container",
          "meaningZhHant": "把某物舀入容器；into 後接盛裝的容器。"
        },
        {
          "expression": "ladle something out",
          "meaningZhHant": "把食物舀出來分給大家；受詞是代名詞時放在中間，如 ladle it out。"
        }
      ],
      "phrases": [],
      "relations": [],
      "primaryExample": {
        "sentenceEn": "She picked up the ladle and ladled the soup into bowls.",
        "translationZhHant": "她拿起湯杓，把湯舀進碗裡。"
      },
