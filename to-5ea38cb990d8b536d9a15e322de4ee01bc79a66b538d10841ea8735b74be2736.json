{"concepts":[{"conceptKey":"word.to.concept.18c54e7dcc5ad931","expressions":[],"labelZhHant":"方向、目的地與狀態變化","meaningLines":[{"meaningZhHant":"表示移動或方向朝向某處，或到達某處。","partOfSpeech":"preposition"},{"meaningZhHant":"表示變化後達到的狀態或結果，相當於「變成」、「到」。","partOfSpeech":"preposition"}],"phrases":[],"primaryExample":{"sentenceEn":"We walked to the station.","translationZhHant":"我們走到車站。"},"priority":"primary","relations":[{"kind":"synonym","meaningZhHant":"朝向（不一定到達）","partOfSpeech":"preposition","spelling":"toward"}],"secondaryExamples":[{"sentenceEn":"The temperature dropped to zero.","translationZhHant":"氣溫降到零度。"}]},{"conceptKey":"word.to.concept.a3fc738b1d45ccc6","expressions":[],"labelZhHant":"動作的對象或接受者","meaningLines":[{"meaningZhHant":"表示動作的對象或接受者，常見於給予、傳遞等動作之後。","partOfSpeech":"preposition"}],"phrases":[],"primaryExample":{"sentenceEn":"She sent an email to her teacher.","translationZhHant":"她寄了一封電子郵件給老師。"},"priority":"primary","relations":[{"kind":"synonym","meaningZhHant":"給、替（表示受益對象）","partOfSpeech":"preposition","spelling":"for"}],"secondaryExamples":[]},{"conceptKey":"word.to.concept.cb6e9005ea6bbf0d","expressions":[{"expression":"from A to B","meaningZhHant":"從 A 到 B；可表示起點和終點或範圍。"}],"labelZhHant":"時間、數量或範圍的終點","meaningLines":[{"meaningZhHant":"表示時間、數量或範圍的終點，相當於「到」、「截至」。","partOfSpeech":"preposition"},{"meaningZhHant":"報時時表示距離下一個整點還差幾分鐘。","partOfSpeech":"preposition"}],"phrases":[],"primaryExample":{"sentenceEn":"The store is open from nine to five.","translationZhHant":"這家店從九點營業到五點。"},"priority":"primary","relations":[{"kind":"synonym","meaningZhHant":"直到（表示時間的終點）","partOfSpeech":"preposition","spelling":"until"}],"secondaryExamples":[{"sentenceEn":"It's ten to six.","translationZhHant":"現在是五點五十分，也就是差十分鐘六點。"}]},{"conceptKey":"word.to.concept.1207b6f2f1432a11","expressions":[],"labelZhHant":"關聯、態度、比較與比例","meaningLines":[{"meaningZhHant":"表示兩者之間的關聯、對某人的態度，或比較、對應與比例。","partOfSpeech":"preposition"}],"phrases":[],"primaryExample":{"sentenceEn":"The answer to this question is simple.","translationZhHant":"這個問題的答案很簡單。"},"priority":"secondary","relations":[],"secondaryExamples":[{"sentenceEn":"She's always kind to me.","translationZhHant":"她總是對我很友善。"},{"sentenceEn":"I prefer tea to coffee.","translationZhHant":"比起咖啡，我更喜歡茶。"},{"sentenceEn":"We won by three goals to one.","translationZhHant":"我們以三比一獲勝。"}]},{"conceptKey":"word.to.concept.b99a657921d15e5e","expressions":[{"expression":"in order to","meaningZhHant":"為了做某事。"},{"expression":"have to","meaningZhHant":"必須；不得不。"},{"expression":"used to + 動詞原形","meaningZhHant":"以前常常做某事，或以前處於某種狀態，現在已不同。"},{"expression":"too ... to ...","meaningZhHant":"太……而無法……。"}],"labelZhHant":"不定詞標記","meaningLines":[{"meaningZhHant":"放在動詞原形前，構成不定詞，常表示要做某事或做某事的目的。","partOfSpeech":"preposition"}],"phrases":[],"primaryExample":{"sentenceEn":"I want to learn English.","translationZhHant":"我想學英文。"},"priority":"primary","relations":[],"secondaryExamples":[]}],"confusables":[{"linkTarget":"word.too","spelling":"too"},{"linkTarget":"word.two","spelling":"two"}],"headwordExpressions":[],"ipa":"/tuː/, /tə/","irregularForms":[],"mainExample":{"conceptKey":"word.to.concept.18c54e7dcc5ad931","sentenceEn":"We walked to the station.","translationZhHant":"我們走到車站。"},"meaningSummary":[{"meaningZhHant":"朝向；給、對；到、截至；變成；關聯、比較；（不定詞標記）","partOfSpeech":"preposition"}],"morphology":null,"schemaVersion":"learner-card-vnext/4","word":"to","wordFamily":[]}
