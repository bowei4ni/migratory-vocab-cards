      "meaningLines": [
        {
          "partOfSpeech": "adjective",
          "meaningZhHant": "未給予足夠注意或思考，容易造成錯誤或傷害；可形容人、行為或工作成果，通常帶負面評價。"
        }
      ],
      "expressions": [
        {
          "expression": "careless with + noun",
          "meaningZhHant": "使用、保管或處理某物時不夠小心。"
        },
        {
          "expression": "careless about + noun / -ing",
          "meaningZhHant": "對某件事不夠用心，或做某事時不夠仔細；也可能暗示不把它當一回事。"
        },
        {
          "expression": "It is careless of someone to + verb",
          "meaningZhHant": "批評某人做某事很粗心；of 後接做出該行為的人。"
        }
      ],
      "phrases": [
