{"concepts":[{"conceptKey":"word.what.concept.ade226b10d71547a","expressions":[{"expression":"what about ...?","meaningZhHant":"……怎麼樣？；那……呢？"},{"expression":"what if ...?","meaningZhHant":"如果……會怎麼樣？"},{"expression":"what ... be like?","meaningZhHant":"……是什麼樣子？；……如何？（詢問特徵或情況）"}],"labelZhHant":"詢問事物或內容","meaningLines":[{"meaningZhHant":"什麼；什麼事物、事情（用來詢問身分、內容或性質）","partOfSpeech":"pronoun"}],"phrases":[],"primaryExample":{"sentenceEn":"What happened?","translationZhHant":"發生什麼事了？"},"priority":"primary","relations":[],"secondaryExamples":[{"sentenceEn":"What's your new teacher like?","translationZhHant":"你的新老師是怎麼樣的人？"}]},{"conceptKey":"word.what.concept.e1cad93512f7f006","expressions":[],"labelZhHant":"詢問名詞所指的事物或種類","meaningLines":[{"meaningZhHant":"什麼；哪一種（放在名詞前提問）","partOfSpeech":"determiner"}],"phrases":[],"primaryExample":{"sentenceEn":"What time does the train leave?","translationZhHant":"火車幾點出發？"},"priority":"primary","relations":[{"kind":"synonym","meaningZhHant":"哪一個；哪一種（通常從已知選項中選擇）","partOfSpeech":"determiner","spelling":"which"}],"secondaryExamples":[]},{"conceptKey":"word.what.concept.9e0639ecb548c94c","expressions":[],"labelZhHant":"指「所……的事物或內容」","meaningLines":[{"meaningZhHant":"所……的事物；……的內容（引出「……的事」）","partOfSpeech":"pronoun"}],"phrases":[],"primaryExample":{"sentenceEn":"I understand what you mean.","translationZhHant":"我懂你的意思。"},"priority":"primary","relations":[],"secondaryExamples":[]},{"conceptKey":"word.what.concept.1e499644ed1b712c","expressions":[],"labelZhHant":"表示驚嘆","meaningLines":[{"meaningZhHant":"多麼……；真是……（用 what 引出名詞片語表示驚嘆；單數可數名詞前加 a/an）","partOfSpeech":"determiner"}],"phrases":[],"primaryExample":{"sentenceEn":"What a beautiful day!","translationZhHant":"天氣真好！"},"priority":"secondary","relations":[],"secondaryExamples":[{"sentenceEn":"What beautiful flowers!","translationZhHant":"這些花真漂亮！"}]},{"conceptKey":"word.what.concept.2c74e11887f6e1b1","expressions":[],"labelZhHant":"表示驚訝或沒聽清楚","meaningLines":[{"meaningZhHant":"什麼？（表示沒聽清楚、驚訝或不相信）","partOfSpeech":"interjection"}],"phrases":[],"primaryExample":{"sentenceEn":"What? I didn't hear you.","translationZhHant":"什麼？我沒聽到你說的話。"},"priority":"secondary","relations":[{"kind":"synonym","meaningZhHant":"蛤？；什麼？","partOfSpeech":"interjection","spelling":"huh"}],"secondaryExamples":[]}],"confusables":[{"linkTarget":"word.that","spelling":"that"}],"coreMeaningZhHant":"用來詢問「什麼」或「哪一種」，也能指「所……的事物或內容」。","headwordExpressions":[{"examples":[{"sentenceEn":"You look worried. What's up?","translationZhHant":"你看起來很擔心。怎麼了？"}],"expression":"What's up?","meaningZhHant":"最近怎麼樣？；有什麼事嗎？"}],"ipa":"/wʌt/","irregularForms":[],"mainExample":{"conceptKey":"word.what.concept.ade226b10d71547a","sentenceEn":"What happened?","translationZhHant":"發生什麼事了？"},"meaningSummary":[{"meaningZhHant":"什麼；所……的事物或內容","partOfSpeech":"pronoun"},{"meaningZhHant":"什麼；哪一種；多麼……","partOfSpeech":"determiner"},{"meaningZhHant":"什麼？","partOfSpeech":"interjection"}],"morphology":null,"schemaVersion":"learner-card-vnext/4","word":"what","wordFamily":[]}
